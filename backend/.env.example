# Database URL (defaults to PostgreSQL in prod, SQLite can be used for local testing)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ubsp

# Redis connection URL (used for Celery broker and backend)
REDIS_URL=redis://localhost:6379/0

# Storage Directories for uploads and generated excel spreadsheets
UPLOAD_DIR=storage/uploads
EXCEL_OUTPUT_DIR=storage/outputs

# JWT Security Key (must be at least 32 characters long in production)
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY
